{
    "manifest_version": 3,
    "icons": {
        "128": "icon.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
            "js": ["passkey-page.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
            "js": ["passkey-content-bridge.js"],
            "all_frames": false,
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "contextMenus",
        "alarms",
        "identity",
        "nativeMessaging"
    ],
    "host_permissions": ["<all_urls>"],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "windows": "Ctrl+Shift+P",
                "mac": "Command+Shift+P",
                "chromeos": "Ctrl+Shift+P",
                "linux": "Ctrl+Shift+P"
            }
        },
        "open-next": {
            "suggested_key": {
                "default": "Ctrl+Shift+Right"
            },
            "description": "Open Next Vault Item"
        },
        "open-previous": {
            "suggested_key": {
                "default": "Ctrl+Shift+Left"
            },
            "description": "Open Previous Vault Item"
        }
    },
    "version": "4.3.0.0",
    "version_name": "4.3.0",
    "name": "Padloc",
    "description": "Padloc Browser Extension"
}
