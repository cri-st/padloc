{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "node",
        "baseUrl": ".",
        "lib": ["es2020", "dom"],
        "types": ["@cloudflare/workers-types", "@types/node"],
        "experimentalDecorators": true,
        "paths": {
            "@padloc/core/*": ["../core/*"],
            "@padloc/locale/*": ["../locale/*"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "global.d.ts"],
    "exclude": ["node_modules", ".wrangler"]
}
