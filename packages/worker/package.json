{
    "name": "@padloc/worker",
    "version": "4.3.0",
    "description": "Padloc Cloudflare Worker backend",
    "private": true,
    "license": "GPLv3",
    "dependencies": {
        "@padloc/core": "4.3.0",
        "@padloc/locale": "4.3.0",
        "@simplewebauthn/server": "13.3.2",
        "drizzle-orm": "^0.38.0"
    },
    "devDependencies": {
        "drizzle-kit": "^0.30.0",
        "esbuild": "0.27.0",
        "wrangler": "4.59.2"
    },
    "overrides": {
        "esbuild": "0.27.0"
    },
    "scripts": {
        "test": "npm run test:ci",
        "dev": "wrangler dev --local --env=dev --ip 127.0.0.1 --port ${PL_WORKER_PORT:-8787}",
        "dev:remote": "wrangler dev --remote --env=dev --ip 127.0.0.1 --port ${PL_WORKER_PORT:-8787}",
        "start": "npm run dev",
        "deploy:dry-run": "wrangler deploy --dry-run --env=dev",
        "deploy:preview": "wrangler deploy --env=preview",
        "deploy:staging": "wrangler deploy --env=staging",
        "deploy:production": "wrangler deploy --env=production",
        "migrate:local": "wrangler d1 migrations apply DB --local",
        "migrate:preview": "wrangler d1 migrations apply DB --remote --env=preview",
        "migrate:staging": "wrangler d1 migrations apply DB --remote --env=staging",
        "migrate:production": "wrangler d1 migrations apply DB --remote --env=production",
        "test:logging-redaction": "node test/run-worker-logging-redaction.mjs",
        "test:session-contract": "node test/session-contract.test.mjs",
        "test:transport-roundtrip": "node test/run-transport-roundtrip.mjs",
        "test:vault-crud": "node test/run-vault-crud-e2e.mjs",
        "test:share-link-do": "node test/share-link-do.test.mjs",
        "test:share-view-rate-limit": "node test/share-view-rate-limit.test.mjs",
        "test:share-link-e2e": "node test/run-share-link-e2e.mjs",
        "test:account-lockout-e2e": "node test/run-account-lockout-e2e.mjs",
        "test:error-semantics": "node test/run-error-semantics.mjs",
        "test:ci": "npm run test:logging-redaction && npm run test:session-contract && npm run test:crypto-parity && npm run test:transport-roundtrip && npm run test:vault-crud && npm run test:account-lockout-e2e && npm run test:share-link-do && npm run test:share-view-rate-limit && npm run test:share-link-e2e",
        "test:crypto-parity": "node test/run-crypto-parity-worker.mjs --local",
        "test:crypto-parity:remote": "node test/run-crypto-parity-worker.mjs --remote",
        "dev:crypto-parity": "wrangler dev test/crypto-parity.worker.ts --local --ip 127.0.0.1 --port 18787",
        "test:hq-instrumentation": "node test/run-hq-instrumentation.mjs",
        "test:hq-local-smoke": "node test/run-hq-local-smoke.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/padloc/padloc.git",
        "directory": "packages/worker"
    },
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    }
}
