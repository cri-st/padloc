# =================================
# Image source (must match the Docker Hub secrets used by
# .github/workflows/docker-publish.yml)
# =================================

DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# =================================
# Public hostname
# =================================

# Domain this instance is reachable at. Caddy uses this to request a
# Let's Encrypt certificate automatically (DNS must already point here).
PL_HOSTNAME=pad.example.com
PL_ADMIN_EMAIL=admin@example.com

# =================================
# Email settings
# =================================

PL_EMAIL_BACKEND=smtp
PL_EMAIL_SMTP_HOST=smtp.example.com
PL_EMAIL_SMTP_PORT=587
PL_EMAIL_SMTP_USER=smtp_username
PL_EMAIL_SMTP_PASSWORD=change-me
PL_EMAIL_SMTP_FROM=mail@example.com
