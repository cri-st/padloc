# =================================
# Image source (GitHub Container Registry — nothing to configure on the CI
# side, .github/workflows/docker-publish.yml pushes here automatically
# using the built-in GITHUB_TOKEN)
# =================================

GHCR_OWNER=your-github-username-or-org-lowercase
IMAGE_TAG=latest

# =================================
# Public hostname
# =================================

# Domain this instance is reachable at (only used to build links in
# emails/CSP — routing/TLS is handled by the Cloudflare Tunnel, not this
# compose stack).
PL_HOSTNAME=pad.example.com
PL_ADMIN_EMAIL=admin@example.com

# =================================
# Database (postgres)
# =================================

PL_DATA_POSTGRES_DATABASE=padloc
PL_DATA_POSTGRES_USER=padloc
PL_DATA_POSTGRES_PASSWORD=change-me

# =================================
# Email settings
# =================================

PL_EMAIL_BACKEND=smtp
# 465 = implicit TLS, requires PL_EMAIL_SMTP_SECURE=true
# 587 = STARTTLS,      requires PL_EMAIL_SMTP_SECURE=false
PL_EMAIL_SMTP_HOST=smtp.example.com
PL_EMAIL_SMTP_PORT=587
PL_EMAIL_SMTP_SECURE=false
PL_EMAIL_SMTP_USER=smtp_username
PL_EMAIL_SMTP_PASSWORD=change-me
PL_EMAIL_SMTP_FROM=mail@example.com

# =================================
# Cloudflare Tunnel
# =================================

# Token for a tunnel created with:
#   cloudflared tunnel create padloc
#   cloudflared tunnel route dns padloc pad.example.com
#   cloudflared tunnel token padloc
# Public hostname in the tunnel config must point to http://nginx:80
CF_TUNNEL_TOKEN=change-me
