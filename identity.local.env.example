# Personal / self-hosted build-time identity overrides.
#
# The committed source in this (public) repo ships NEUTRAL placeholder defaults
# only. Put your REAL branding, hosts, and passkey RP roots here so they are
# baked into the PWA / extension bundles WITHOUT being committed.
#
# Usage — copy this file and fill in your values, then source it before builds:
#
#   cp identity.local.env.example identity.local.env   # identity.local.env is git-ignored
#   set -a; . ./identity.local.env; set +a
#   npm run pwa:build
#   npm run web-extension:build
#
# Worker RUNTIME values (CLIENT_URL, ALLOW_ORIGIN, EMAIL_FROM_ADDRESS,
# RESEND_API_KEY, ...) live separately in packages/worker/wrangler.local.toml
# (also git-ignored) and/or as Cloudflare-side Worker vars/secrets.

# App display name shown in the PWA and extension. Default: "Padloc".
PL_APP_NAME="Padloc"

# API base URL the client/extension talks to (your deployed Worker).
PL_SERVER_URL="https://api.example.com"

# Public app URL (PWA origin).
PL_PWA_URL="https://app.example.com"

# Support contact shown in built surfaces. Default: support@padloc.app.
PL_SUPPORT_EMAIL="support@example.com"

# Terms-of-service link. Default: the assets/manifest.json value.
PL_TERMS_OF_SERVICE_URL="https://example.com/tos/"

# Extra passkey relying-party roots to trust (comma-separated, your domain[s]).
# The Google baseline is always allowed; this only APPENDS your roots.
PL_PASSKEY_RP_ROOTS="example.com"

# Optional: v3 migration help link shown in the extension.
PL_MIGRATE_V3_HELP_URL=""
